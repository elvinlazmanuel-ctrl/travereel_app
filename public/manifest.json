{
  "name": "Travereel - Travel Social Platform",
  "short_name": "Travereel",
  "description": "Plan, share, and discover amazing travel experiences with friends",
  "start_url": "/?source=pwa",
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
  "background_color": "#0a0a0a",
  "theme_color": "#FF6B6B",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "categories": ["travel", "social", "lifestyle", "photo"],
  "icons": [
    {
      "src": "/logo.png",
      "sizes": "any",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/feed.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "label": "Browse travel stories and posts"
    },
    {
      "src": "/screenshots/itinerary.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "label": "Plan your travel itinerary"
    }
  ],
  "shortcuts": [
    {
      "name": "Create Post",
      "short_name": "Post",
      "description": "Share your travel experience",
      "url": "/?action=create-post",
      "icons": [
        {
          "src": "/logo.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Plan Itinerary",
      "short_name": "Itinerary",
      "description": "Create a new travel plan",
      "url": "/?action=create-itinerary",
      "icons": [
        {
          "src": "/logo.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/api/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "photos",
          "accept": ["image/*"]
        }
      ]
    }
  },
  "related_applications": [],
  "prefer_related_applications": false
}
